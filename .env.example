# Copy to .env (docker compose reads it) or export in your shell.
DATABASE_URL=postgres://stem:stem@localhost:5432/stemsaas
DJANGO_SECRET_KEY=change-me
JWT_SECRET=change-me-too
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
ACCESS_TOKEN_MINUTES=60
FREE_TIER_MONTHLY_LIMIT=3
MAX_UPLOAD_MB=50
AUTH_THROTTLE_RATE=20/min
STORAGE_DIR=./storage
